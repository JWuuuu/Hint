# Examples are intentionally rejected by release preflight. Supply real values.
# Native WebViews cannot use the Vite development proxy.
VITE_API_BASE_URL=https://api.example.com

# Required for production Share Receipts. The QR code and receipt link point
# here; use the public App Store or Hint download page.
VITE_HINT_DOWNLOAD_URL=https://example.com/download
VITE_HINT_PUBLIC_URL=https://example.com
HINT_ASSOCIATED_DOMAIN=example.com
HINT_APPLE_TEAM_ID=

# Optional if the app is hosted under a subpath. Native builds should usually
# keep this as "/".
BASE_PATH=/

# This beta uses device sessions and local profiles. No Firebase/OAuth login.
