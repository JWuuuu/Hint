+function bodyKey(body: string): string {
+  const key = body.toLowerCase().replace(/[\s_-]/g, "");
+  return key === "asc" || key === "ascendant" ? "rising" : key;
+}
+export function canonicalBody(body: string): PlanetBody | null {
+  const key = bodyKey(body);
+  return Object.hasOwn(bodies, key) ? key as PlanetBody : null;
+}
+export function bodyName(body: string, language: HintLanguage): string { const key = canonicalBody(body); const row = key ? bodies[key] : null; return row ? astroText(language, row.name) : body; }
+export function bodyDescription(body: string, language: HintLanguage): string {
+  const key = canonicalBody(body);
+  const row = key ? bodies[key] : null;
+  return astroText(language, row?.description ?? ["This point has no explanation in the current guide.", "当前指南尚未提供这个配置点的说明。", "La guía actual no incluye una explicación de este punto.", "このポイントの説明は、現在のガイドにはありません。", "현재 가이드에는 이 지점에 대한 설명이 없어요."]);
+}
