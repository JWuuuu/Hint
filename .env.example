ASTROLOGYAPI_USER_ID=
ASTROLOGYAPI_API_KEY=
NASA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Voice: spoken replies and server speech-to-text (used when a device has no
# on-device recognition, e.g. Android WebView or Firefox).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ASTRO_PROVIDER=astrologyapi
HOUSE_SYSTEM=placidus

# Firebase Auth web config. Enable Google, Apple, and Phone providers in the
# matching Firebase project before production login/signup can create accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
